[Unit]
Description=EIP Guard (Aliyun EIP switch + Cloudflare + Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eipguard
User=eipguard
Group=eipguard
EnvironmentFile=/opt/eipguard/.env
ExecStart=/opt/eipguard/.venv/bin/python -m eipguard -c /opt/eipguard/config.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
