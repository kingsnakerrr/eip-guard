[Unit]
Description=EIP Guard probe agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eip-probe
EnvironmentFile=/opt/eip-probe/probe.env
# 改成这台机器的实际位置：cn 或 overseas
Environment=ZONE=overseas
ExecStart=/usr/bin/python3 /opt/eip-probe/server.py --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
