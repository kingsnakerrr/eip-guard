# 复制为 .env（install.sh 会自动生成）。chmod 600 .env

# ---------- Telegram ----------
# @BotFather /newbot 拿到的 token
TG_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# 管理员 chat id（数字，逗号分隔）。不知道就先留空，之后执行：
#   eipguard --bind 你的chatid
TG_ADMIN_IDS=
# /bind 口令（可空）
TG_BIND_TOKEN=
# 服务器连不上 Telegram 时的代理（国内机器必填）
# 例：socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
TG_PROXY=

# 阿里云 AK/SK、Cloudflare Token、实例都不需要写在 .env 里。
# 装完后在 Telegram 里 /account add、/cf、/target add，
# 或者用命令行 eipguard account add / cf / target add。
# 它们会保存到 config.yaml（权限 600）。
