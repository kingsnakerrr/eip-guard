# 复制为 .env 并填写。权限收紧：chmod 600 .env

# ---------- Telegram ----------
# @BotFather 创建机器人后拿到的 token
TG_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# 管理员 chat id，可写多个逗号分隔；不知道就先留空，启动后私聊机器人发送 /bind <口令> 完成绑定
TG_ADMIN_IDS=
# 首次绑定口令，随便设一个长串（设为空则关闭 /bind）
TG_BIND_TOKEN=
# 通知频道 id，例如 -1001234567890（机器人必须是频道管理员）。也可运行时用 /channel 设置
TG_CHANNEL_ID=

# ---------- 阿里云账号 1（RAM 子账号，最小权限，见 README）----------
ALIYUN_AK_ID=LTAI5txxxxxxxxxxxxxxxx
ALIYUN_AK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 阿里云账号 2 ----------
ALIYUN_AK_ID_2=LTAI5txxxxxxxxxxxxxxxx
ALIYUN_AK_SECRET_2=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Cloudflare ----------
# 权限：Zone.DNS:Edit + Zone:Read
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 自建探针 ----------
# 关键：一台国内（zone: cn）+ 一台国外（zone: overseas），token 相同
# 判定逻辑就是「同一端口，国内不通 + 国外通」
PROBE_CN_URL=http://你的国内探针IP:8787
PROBE_OS_URL=http://你的国外探针IP:8787
PROBE_AGENT_TOKEN=change-me-to-a-long-random-string
